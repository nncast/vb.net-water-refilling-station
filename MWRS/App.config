<?xml version="1.0"?>
<configuration>
    <connectionStrings>
        <!-- MySQL connection used by the app. After building, this lives in
             MWRS.exe.config next to the program: edit the server, port,
             user (Uid) and password (Pwd) there to match your MySQL setup. -->
        <add name="MwrsDb" connectionString="Server=localhost;Port=3306;Database=dbmwrs;Uid=root;Pwd=;" providerName="MySql.Data.MySqlClient"/>
    </connectionStrings>
    <appSettings>
        <!-- Crystal Reports: the data source (ODBC DSN / server name) the
             reports were designed with. The database, user and password are
             taken from the MwrsDb connection string above. -->
        <add key="ReportServer" value="POSMWRS"/>
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
</configuration>
